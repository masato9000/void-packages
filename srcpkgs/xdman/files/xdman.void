#!/bin/sh

notify() {
	if [ -t 0 ]; then
		echo $@
	elif command -v notify-send; then
		(
		_options="-i dialog-error -t 10000"
		notify-send $_options "XDMAN" "$*"
		)
	fi
}

if [ $(id -u) -eq 0 ]; then
	notify Don\'t run this as root, you numpty.
	exit 1
fi

/usr/bin/java -Dsun.java2d.xrender=false -Xmx1024m -jar /opt/xdman/xdman.jar

